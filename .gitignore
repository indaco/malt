.zig-cache/
zig-out/
coverage/

# Override global gitignore — vendored SQLite is intentional
!vendor/

.claude-flow
.swarm
.mcp.json

/docs

# Test certificate fixtures. A user-level gitignore commonly excludes *.pem;
# these are committed inputs the CA-classifier tests embed and iterate, so
# re-include them explicitly or the suite will not compile on a clean clone.
!tests/fixtures/**/*.pem
